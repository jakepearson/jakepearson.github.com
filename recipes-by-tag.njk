---
layout: default.njk
title: Categories
nav: true
permalink: /recipes-by-tag.html
---

{% for tag in collections.tagList %}
  <h3>{{ tag }}</h3>
  <ul>
    {% for post in collections.postsByTitle %}
      {% if post.data.tags and post.data.tags.includes(tag) %}
        <li><a href="{{ post.url }}">{{ post.data.title }}</a></li>
      {% endif %}
    {% endfor %}
  </ul>
{% endfor %}
